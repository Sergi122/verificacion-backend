# Copiá este archivo como .env para probar en tu máquina (no lo subas a Git).
# En Render, estas mismas variables se cargan desde el panel "Environment", no desde este archivo.

# El JSON completo de la Service Account de Firebase, en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}

# El mismo texto secreto que la app Flutter manda en el header X-Verificacion-Token.
# Inventá cualquier texto largo y random, y usá el mismo en los dos lados.
VERIFICACION_SECRETO=cambia-esto-por-un-texto-secreto-largo

FIREBASE_PROJECT_ID=laundry-app-asustadores
